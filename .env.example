# Zendesk QA API credentials
# Generate via Zendesk QA -> Settings -> Integrations -> create custom integration
ZQA_API_TOKEN=

# Base URL for the Zendesk QA API. The canonical Public API host is still
# pub.klausapp.com even after the rebrand. Tenant-scoped export paths may
# live at https://<subdomain>.zendeskqa.com or https://<subdomain>.zendesk.com.
ZQA_BASE_URL=https://pub.klausapp.com

# Account and workspace identifiers shown next to the integration in QA UI.
ZQA_ACCOUNT_ID=
ZQA_WORKSPACE_ID=
